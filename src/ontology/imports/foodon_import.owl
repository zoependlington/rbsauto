        <oboInOwl:hasExactSynonym>frucht (exact, German)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fruto (exact, Spanish)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>果実 (exact, Japanese)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>coenocarp (narrow)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>syncarp (narrow)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0009001</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/po#Angiosperm"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/po#Arabidopsis"/>
