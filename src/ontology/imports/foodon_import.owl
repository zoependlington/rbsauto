        <oboInOwl:hasBroadSynonym>aggregate fruit  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>compound fruit  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>dehiscent fruit  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>diaspore  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>indehiscent fruit  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>multiple fruit  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>propagule  (broad)</oboInOwl:hasBroadSynonym>
