.PHONY: .FORCE

.PHONY: all
all: all_odk

.PHONY: all_odk
all_odk: odkversion config_check test custom_reports all_assets

.PHONY: odkversion
odkversion:
	@echo "INFO: ODK Makefile "Unknown""
	@odk-helper info --tools

.PHONY: config_check
config_check:
	@if [ "$$(tr -d '\r' < $(ONT)-odk.yaml | sha256sum | cut -c1-64)" = "$(CONFIG_HASH)" ]; then \
	        echo "INFO: Repository is up-to-date." ; else \
	        echo "WARNING: Your ODK configuration has changed since this Makefile was generated." ; \
	        echo "         You may need to run 'sh run.sh update_repo'." ; \
	fi

.PHONY: test
test: odkversion validate_idranges \
      reason_test sparql_test robot_reports check_rdfxml_products \
      $(REPORTDIR)/validate_profile_owl2dl_$(ONT).owl.txt
	@echo "INFO: Finished running all tests successfully."

.PHONY: test_fast
test_fast:
	$(MAKE_FAST) test

.PHONY: reason_test
reason_test: $(EDIT_PREPROCESSED)
	$(ROBOT) reason --input $< \
	                --reasoner $(REASONER) \
	                --equivalent-classes-allowed asserted-only \
	                --exclude-tautologies structural

.PHONY: release_diff
release_diff: $(REPORTDIR)/release-diff.md

$(TMPDIR) $(REPORTDIR) $(MIRRORDIR) $(IMPORTDIR) $(COMPONENTSDIR) $(SUBSETDIR):
	mkdir -p $@


# ----------------------------------------
# ODK-managed ROBOT plugins
# ----------------------------------------

# Make sure ROBOT knows where to find plugins
export ROBOT_PLUGINS_DIRECTORY=$(TMPDIR)/plugins

# Override this rule in pizza.Makefile to install custom plugins
.PHONY: custom_robot_plugins
custom_robot_plugins:

# Install all ROBOT plugins to the runtime plugins directory
.PHONY: all_robot_plugins
all_robot_plugins: $(foreach plugin,$(notdir $(wildcard $(ODK_RESOURCES_DIR)/robot/plugins/*.jar)),$(ROBOT_PLUGINS_DIRECTORY)/$(plugin)) \
	           $(foreach plugin,$(notdir $(wildcard ../../plugins/*.jar)),$(ROBOT_PLUGINS_DIRECTORY)/$(plugin)) \
	           custom_robot_plugins  \

# Default rule to install plugins
$(ROBOT_PLUGINS_DIRECTORY)/%.jar:
	@mkdir -p $(ROBOT_PLUGINS_DIRECTORY)
	@if [ -f ../../plugins/$*.jar ]; then \
	        ln ../../plugins/$*.jar $@ ; \
	elif [ -f $(ODK_RESOURCES_DIR)/robot/plugins/$*.jar ]; then \
	        cp $(ODK_RESOURCES_DIR)/robot/plugins/$*.jar $@ ;  \
	fi


# ----------------------------------------
# Internal intermediate products
# ----------------------------------------

# The -edit file plus all components, but without any import module.
$(SRCMERGED): $(EDIT_PREPROCESSED) $(OTHER_SRC)
	$(ROBOT) remove --input $< --select imports --trim false \
	         merge $(foreach src, $(OTHER_SRC), --input $(src)) \
	         convert --format ofn --output $@

# Override this rule in pizza.Makefile to perform any needed
# custom preprocessing on the -edit file.
$(EDIT_PREPROCESSED): $(SRC)
	$(ROBOT) convert --input $< --format ofn --output $@


# ----------------------------------------
# Quality control
# ----------------------------------------

# ROBOT reports
# ----------------------------------------

OBO_REPORT              = $(SRC)-obo-report
REPORTS                 = $(OBO_REPORT)
REPORT_FILES            = $(foreach report, $(REPORTS), $(REPORTDIR)/$(report).tsv)
REPORT_FAIL_ON          = None
REPORT_LABEL            = --labels true
REPORT_PROFILE_OPTS     = 

.PHONY: robot_reports
robot_reports: $(REPORT_FILES)

.PHONY: all_reports
all_reports: custom_reports robot_reports

$(REPORTDIR)/%-obo-report.tsv: % | $(REPORTDIR)
	$(ROBOT) report --input $< $(REPORT_LABEL) $(REPORT_PROFILE_OPTS) \
	                --fail-on $(REPORT_FAIL_ON) \
	                --base-iri $(URIBASE)/PIZZA_ \
	                --base-iri $(URIBASE)/pizza \
	                --print 5 --output $@

# ROBOT OWL profile check
# ----------------------------------------

# The merge step is necessary to avoid undeclared entity violations.
$(REPORTDIR)/validate_profile_owl2dl_%.txt: % | $(REPORTDIR)
	$(ROBOT) merge --input $< \
	         validate-profile --profile DL \
	                          --output $@ \
	|| { cat $@ && exit 1; }
.PRECIOUS: $(REPORTDIR)/validate_profile_owl2dl_%.txt

validate_profile_%: $(REPORTDIR)/validate_profile_owl2dl_%.txt
	@echo "INFO: $* profile validation completed."

# SPARQL-based checks and reports
# ----------------------------------------

# The SPARQL queries used by those checks live in the ../sparql directory,
# in files whose name is of the form NAME-violation.sparql. Adding the
# NAME in the list below will enable the corresponding check.

SPARQL_VALIDATION_CHECKS = owldef-self-reference iri-range label-with-iri multiple-replaced_by dc-properties

sparql_test: $(SRCMERGED) | $(REPORTDIR)
ifneq ($(SPARQL_VALIDATION_CHECKS),)
	$(ROBOT) verify --input $(SRCMERGED) \
	                --queries $(foreach name, $(SPARQL_VALIDATION_CHECKS), $(SPARQLDIR)/$(name)-violation.sparql) \
	                --output-dir $(REPORTDIR)
endif

# SPARQL "exports" differ from SPARQL checks in that
# (i) the files containing the queries do not have a '-violation' suffix,
# (ii) they do not trigger an error, they merely report what they found.

SPARQL_EXPORTS = basic-report class-count-by-prefix edges xrefs obsoletes synonyms

.PHONY: custom_reports
custom_reports: $(EDIT_PREPROCESSED) | $(REPORTDIR)
ifneq ($(SPARQL_EXPORTS),)
	$(ROBOT) query --input $< --use-graphs true \
	               --queries $(foreach name, $(SPARQL_EXPORTS), $(SPARQLDIR)/$(name).sparql) \
	               --format tsv --output-dir $(REPORTDIR)
endif


# ----------------------------------------
# Imports
# ----------------------------------------

IMPORTS = foodon

# Mirrors
# ----------------------------------------

ifeq ($(MIR),true)
## ONTOLOGY: foodon
.PHONY: download-mirror-foodon
download-mirror-foodon: | $(TMPDIR)
	odk-helper download --output $(TMPDIR)/$@.owl \
	                    --reference $(MIRRORDIR)/foodon.owl \
	                    --max-retry 4 \
	                    $(OBOBASE)/foodon.owl

$(MIRRORDIR)/foodon.owl: download-mirror-foodon
	@if [ -f $(TMPDIR)/download-mirror-foodon.owl ]; then \
	        $(ROBOT) convert --input $(TMPDIR)/download-mirror-foodon.owl \
	                         --format ofn --output $@ ; \
	fi
.PRECIOUS: $(MIRRORDIR)/foodon.owl

endif # MIR=true

# Imports seeding system
# ----------------------------------------

# All entities referenced from the -edit file and any component
PRESEED                 = $(TMPDIR)/pre_seed.txt
# All entities to import in addition to defined in the individual _terms.txt files
IMPORTSEED              = $(TMPDIR)/seed.txt
T_IMPORTSEED            = --term-file $(IMPORTSEED)

$(PRESEED): $(SRCMERGED) | $(TMPDIR)
	$(ROBOT) query --input $< --format --csv \
	               --query $(SPARQLDIR)/terms.sparql $@

$(IMPORTSEED): $(PRESEED) | $(TMPDIR)
	cat $^ | sort | uniq > $@

# Import modules
# ----------------------------------------

IMPORT_ROOTS          = $(IMPORTDIR)/foodon_import
IMPORT_FILES          = $(foreach r, $(IMPORT_ROOTS), $(r).owl)

ifeq ($(IMP),true)

ANNOTATION_PROPERTIES = rdfs:label IAO:0000115 OMO:0002000
## Default module type (slme)
$(IMPORTDIR)/%_import.owl: $(MIRRORDIR)/%.owl $(IMPORTDIR)/%_terms.txt \
                           $(IMPORTSEED) | all_robot_plugins
	$(ROBOT) annotate --input $< --remove-annotations \
	         odk:normalize --add-source true \
	         extract --term-file $(IMPORTDIR)/$*_terms.txt $(T_IMPORTSEED) \
	                 --force true --copy-ontology-annotations true \
	                 --individuals include --method BOT \
	         remove $(foreach p, $(ANNOTATION_PROPERTIES), --term $(p)) \
	                --term-file $(IMPORTDIR)/$*_terms.txt $(T_IMPORTSEED) \
	                --select complement --select annotation-properties \
	         odk:normalize --base-iri http://purl.obolibrary.org/obo \
	                       --subset-decls true --synonym-decls true \
	         repair --merge-axiom-annotations true \
	         $(ANNOTATE_CONVERT_FILE)

.PRECIOUS: $(IMPORTDIR)/%_import.owl

endif # IMP=true

.PHONY: all_imports
all_imports: $(IMPORT_FILES)

.PHONY: refresh-imports
refresh-imports:
	$(MAKE) IMP=true MIR=true PAT=false IMP_LARGE=true clean all_imports

.PHONY: no-mirror-refresh-imports
no-mirror-refresh-imports:
	$(MAKE) --assume-new=$(SRC) \
	        $(foreach imp, $(IMPORTS), --assume-new=$(IMPORTDIR)/$(imp)_terms.txt) \
	        IMP=true MIR=false PAT=false IMP_LARGE=true all_imports

.PHONY: refresh-imports-excluding-large
refresh-imports-excluding-large:
	$(MAKE) IMP=true MIR=true PAT=false IMP_LARGE=false clean all_imports

.PHONY: refresh-%
refresh-%:
	rm -f $(TMPDIR)/download-mirror-$*.owl.info
	$(MAKE) --assume-new=$(SRC) --assume-new=$(IMPORTDIR)/$*_terms.txt \
	        IMP=true IMP_LARGE=true MIR=true PAT=false $(IMPORTDIR)/$*_import.owl

.PHONY: no-mirror-refresh-%
no-mirror-refresh-%:
	$(MAKE) --assume-new=$(SRC) --assume-new=$(IMPORTDIR)/$*_terms.txt \
	        IMP=true IMP_LARGE=true MIR=false PAT=false $(IMPORTDIR)/$*_import.owl


# ----------------------------------------
# Components
# ----------------------------------------
# Some ontologies contain external and internal components.
# A component is included in the ontology in its entirety.

ifeq ($(COMP),true)

$(COMPONENTSDIR)/%.owl: $(TMPDIR)/stamp-component-%.owl | $(COMPONENTSDIR)
	test -f $@ || touch $@
.PRECIOUS: $(COMPONENTSDIR)/%.owl

$(TMPDIR)/stamp-component-%.owl: | $(TMPDIR)
	touch $@
.PRECIOUS: $(TMPDIR)/stamp-component-%.owl

$(COMPONENTSDIR)/subclasses.owl: $(TMPDIR)/stamp-component-subclasses.owl \
                $(TEMPLATEDIR)/subclasses.csv
	$(ROBOT) template --template $(TEMPLATEDIR)/subclasses.csv \
	                  $(ANNOTATE_CONVERT_FILE)
.PRECIOUS: $(COMPONENTSDIR)/subclasses.owl

endif # COMP=true

.PHONY: all_components
all_components: $(OTHER_SRC)

.PHONY: recreate-components
recreate-components:
	$(MAKE) --assume-new=$(TMPDIR)/stamp-component-subclasses.owl \
	        COMP=true IMP=false MIR=true PAT=true all_components

.PHONY: no-mirror-recreate-components
no-mirror-recreate-components:
	$(MAKE) --assume-new=$(TMPDIR)/stamp-component-subclasses.owl \
	        COMP=true IMP=false MIR=false PAT=true all_components

.PHONY: recreate-%
recreate-%:
	rm -f $(TMPDIR)/download-component-$*.owl.info
	$(MAKE) --assume-new=$(TMPDIR)/stamp-component-$*.owl \
	        COMP=true IMP=false MIR=true PAT=true $(COMPONENTSDIR)/$*.owl

.PHONY: no-mirror-recreate-%
no-mirror-recreate-%:
	$(MAKE) --assume-new=$(TMPDIR)/stamp-component-$*.owl \
	        COMP=true IMP=false MIR=false PAT=true $(COMPONENTSDIR)/$*.owl


# ----------------------------------------
# Release artefacts
# ----------------------------------------

SHARED_ROBOT_COMMANDS          =
ROBOT_RELEASE_IMPORT_MODE      = $(ROBOT) merge --input $<
ROBOT_RELEASE_IMPORT_MODE_BASE = $(ROBOT) remove --input $< --select imports --trim false \
                                          merge $(foreach src, $(OTHER_SRC), --input $(src))

MAIN_PRODUCTS = $(sort $(foreach a, $(RELEASE_ARTEFACTS), $(a)) $(ONT))
MAIN_FILES    = $(foreach p, $(MAIN_PRODUCTS), $(foreach f, $(FORMATS), $(p).$(f)))

.PHONY: all_main
all_main: $(MAIN_FILES) check_rdfxml_products

.PHONY: check_rdfxml_products
check_rdfxml_products: $(foreach product, $(MAIN_PRODUCTS), check_rdfxml_$(product).owl)

check_rdfxml_%: %
	@odk-helper check-rdfxml $<

# Release artefacts: main pipelines
# ----------------------------------------

# The primary release artefact.
$(ONT).owl: $(ONT)-full.owl
	$(ROBOT) annotate --input $< --ontology-iri $(URIBASE)/$@ \
	         $(ANNOTATE_ONTOLOGY_VERSION) --output $@

# Full: The full artefacts with imports merged, reasoned.
$(ONT)-full.owl: $(EDIT_PREPROCESSED) $(OTHER_SRC) $(IMPORT_FILES)
	$(ROBOT_RELEASE_IMPORT_MODE) \
	         reason --reasoner $(REASONER) \
	                --equivalent-classes-allowed asserted-only \
	                --exclude-tautologies structural \
	         relax $(RELAX_OPTIONS) \
	         reduce --reasoner $(REASONER) $(REDUCE_OPTIONS) \
	         $(SHARED_ROBOT_COMMANDS) \
	         annotate --ontology-iri $(ONTBASE)/$@ \
	         $(ANNOTATE_ONTOLOGY_VERSION) \
	                  --output $@

# Release artefacts: export formats
# ----------------------------------------

$(ONT).obo: $(ONT).owl
	$(ROBOT) convert --input $< --check false \
	                 --format obo $(OBO_FORMAT_OPTIONS) --output $@

$(ONT)-full.obo: $(ONT)-full.owl
	$(ROBOT) convert --input $< --check false \
	                 --format obo $(OBO_FORMAT_OPTIONS) --output $@


