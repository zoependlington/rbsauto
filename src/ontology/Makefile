RELEASE_ARTEFACTS         = $(ONT)-full

# Directories
RELEASEDIR                = ../..
DOCSDIR                   = ../../docs
REPORTDIR                 = reports
TMPDIR                    = tmp
MIRRORDIR                 = mirror
IMPORTDIR                 = imports
SUBSETDIR                 = subsets
SCRIPTSDIR                = ../scripts
