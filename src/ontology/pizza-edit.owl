<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/pizza/"
     xml:base="http://example.org/pizza"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">

    <owl:Ontology rdf:about="http://example.org/pizza/pizza-edit.owl">
        <rdfs:comment xml:lang="en">Demo ontology for the Pizza Ontology Claude Code agent example. Deliberately toy content -- see README.md. Structure loosely follows the Manchester Pizza tutorial ontology used for teaching OWL/Protege.</rdfs:comment>
        <owl:versionInfo>0.1.0</owl:versionInfo>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/pizza/imports/foodon_import.owl"/>
    </owl:Ontology>

    <!-- ============================== -->
    <!-- Annotation properties          -->
    <!-- ============================== -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000115">
        <rdfs:label xml:lang="en">definition</rdfs:label>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000117">
        <rdfs:label xml:lang="en">term editor</rdfs:label>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0100001">
        <rdfs:label xml:lang="en">term replaced by</rdfs:label>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>

    <!-- ============================== -->
    <!-- Object properties              -->
    <!-- ============================== -->

    <owl:ObjectProperty rdf:about="http://example.org/pizza/PIZZA_R0000001">
        <rdfs:label xml:lang="en">has topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">Relates a pizza to an ingredient placed on top of it before baking.</obo:IAO_0000115>
        <rdfs:domain rdf:resource="http://example.org/pizza/PIZZA_0000001"/>
        <rdfs:range rdf:resource="http://example.org/pizza/PIZZA_0000005"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/pizza/PIZZA_R0000002">
        <rdfs:label xml:lang="en">has base</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">Relates a pizza to the dough base it is built on.</obo:IAO_0000115>
        <rdfs:domain rdf:resource="http://example.org/pizza/PIZZA_0000001"/>
        <rdfs:range rdf:resource="http://example.org/pizza/PIZZA_0000002"/>
    </owl:ObjectProperty>

    <!-- ============================== -->
    <!-- Top-level classes               -->
    <!-- ============================== -->

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000001">
        <rdfs:label xml:lang="en">pizza</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A baked dish consisting of a base topped with various ingredients before baking.</obo:IAO_0000115>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000002">
        <rdfs:label xml:lang="en">pizza base</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">The dough foundation of a pizza, prepared before toppings are added.</obo:IAO_0000115>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000005">
        <rdfs:label xml:lang="en">pizza topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">An ingredient placed on a pizza base before baking.</obo:IAO_0000115>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000019">
        <rdfs:label xml:lang="en">named pizza</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A pizza with a conventional name, defined by a fixed set of toppings and a base.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000001"/>
    </owl:Class>

    <!-- ============================== -->
    <!-- Pizza bases                     -->
    <!-- ============================== -->

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000003">
        <rdfs:label xml:lang="en">thin and crispy base</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A pizza base rolled thin, producing a crisp crust when baked.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000002"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000004">
        <rdfs:label xml:lang="en">deep pan base</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A thick pizza base baked in a deep pan, producing a soft, bread-like crust.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000002"/>
    </owl:Class>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/pizza/PIZZA_0000003"/>
            <rdf:Description rdf:about="http://example.org/pizza/PIZZA_0000004"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- ============================== -->
    <!-- Topping categories               -->
    <!-- ============================== -->

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000006">
        <rdfs:label xml:lang="en">cheese topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A pizza topping made from cheese.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000005"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000009">
        <rdfs:label xml:lang="en">meat topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A pizza topping made from meat.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000005"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000012">
        <rdfs:label xml:lang="en">vegetable topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A pizza topping made from a vegetable or fruit used as a vegetable, excluding cheese and meat.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000005"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000016">
        <rdfs:label xml:lang="en">seafood topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A pizza topping made from fish or shellfish.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000005"/>
    </owl:Class>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/pizza/PIZZA_0000006"/>
            <rdf:Description rdf:about="http://example.org/pizza/PIZZA_0000009"/>
            <rdf:Description rdf:about="http://example.org/pizza/PIZZA_0000012"/>
            <rdf:Description rdf:about="http://example.org/pizza/PIZZA_0000016"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- ============================== -->
    <!-- Leaf toppings                    -->
    <!-- ============================== -->

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000007">
        <rdfs:label xml:lang="en">mozzarella topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A cheese topping made from mozzarella.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">fior di latte topping</oboInOwl:hasExactSynonym>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000006"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000008">
        <rdfs:label xml:lang="en">parmesan topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A cheese topping made from parmesan.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000006"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000010">
        <rdfs:label xml:lang="en">pepperoni topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A meat topping made from sliced pepperoni sausage.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000009"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000011">
        <rdfs:label xml:lang="en">ham topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A meat topping made from cured ham.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000009"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000013">
        <rdfs:label xml:lang="en">mushroom topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A vegetable topping made from sliced mushroom.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000012"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000014">
        <rdfs:label xml:lang="en">onion topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A vegetable topping made from sliced onion.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000012"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000015">
        <rdfs:label xml:lang="en">tomato topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A vegetable topping made from sliced or pureed tomato.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000012"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000017">
        <rdfs:label xml:lang="en">anchovy topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A seafood topping made from cured anchovy fillets.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000016"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000018">
        <rdfs:label xml:lang="en">prawns topping</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A seafood topping made from prawns.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000016"/>
    </owl:Class>

    <!-- ============================== -->
    <!-- Named pizzas                     -->
    <!-- ============================== -->

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000020">
        <rdfs:label xml:lang="en">margherita pizza</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A named pizza on a thin and crispy base topped with mozzarella and tomato.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/PIZZA_R0000002"/>
                <owl:someValuesFrom rdf:resource="http://example.org/pizza/PIZZA_0000003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/PIZZA_R0000001"/>
                <owl:someValuesFrom rdf:resource="http://example.org/pizza/PIZZA_0000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/PIZZA_R0000001"/>
                <owl:someValuesFrom rdf:resource="http://example.org/pizza/PIZZA_0000015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <!-- Closure axiom: without this, OWL's open-world assumption means the
             reasoner can never rule out an unstated meat/seafood topping, so
             VegetarianPizza classification (below) would never fire. -->
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/PIZZA_R0000001"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://example.org/pizza/PIZZA_0000007"/>
                            <rdf:Description rdf:about="http://example.org/pizza/PIZZA_0000015"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000021">
        <rdfs:label xml:lang="en">pepperoni pizza</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A named pizza on a thin and crispy base topped with pepperoni and mozzarella.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/PIZZA_R0000002"/>
                <owl:someValuesFrom rdf:resource="http://example.org/pizza/PIZZA_0000003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/PIZZA_R0000001"/>
                <owl:someValuesFrom rdf:resource="http://example.org/pizza/PIZZA_0000010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/PIZZA_R0000001"/>
                <owl:someValuesFrom rdf:resource="http://example.org/pizza/PIZZA_0000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <!-- Closure axiom, see the comment on MargheritaPizza above. This one
             deliberately keeps PepperoniPizza OUT of VegetarianPizza, since
             pepperoni topping is a MeatTopping. -->
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/PIZZA_R0000001"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://example.org/pizza/PIZZA_0000010"/>
                            <rdf:Description rdf:about="http://example.org/pizza/PIZZA_0000007"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ============================== -->
    <!-- Defined (equivalent) class:      -->
    <!-- the reasoner classifies pizzas   -->
    <!-- into this based on their         -->
    <!-- toppings, nothing asserts it     -->
    <!-- directly.                        -->
    <!-- ============================== -->

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000100">
        <rdfs:label xml:lang="en">hawaiian pizza</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A named pizza characterized by ham and pineapple toppings on a thin and crispy base.</obo:IAO_0000115>
        <obo:IAO_0000117>AI agent</obo:IAO_0000117>
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/PIZZA_0000019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/PIZZA_R0000002"/>
                <owl:someValuesFrom rdf:resource="http://example.org/pizza/PIZZA_0000003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/PIZZA_R0000001"/>
                <owl:someValuesFrom rdf:resource="http://example.org/pizza/PIZZA_0000011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/PIZZA_R0000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FOODON_00003459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/PIZZA_R0000001"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://example.org/pizza/PIZZA_0000011"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FOODON_00003459"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/PIZZA_0000022">
        <rdfs:label xml:lang="en">vegetarian pizza</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">A pizza with no meat topping and no seafood topping. Membership is inferred by the reasoner from a pizza's asserted toppings, not asserted directly.</obo:IAO_0000115>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/pizza/PIZZA_0000001"/>
                    <owl:Class>
                        <owl:complementOf>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://example.org/pizza/PIZZA_R0000001"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://example.org/pizza/PIZZA_0000009"/>
                                            <rdf:Description rdf:about="http://example.org/pizza/PIZZA_0000016"/>
                                        </owl:unionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:complementOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

</rdf:RDF>
